   118→        -- Left Graphic Background (behind foreground)
   119→        RPGBB.leftGraphicBg = RPGBB.leftGraphicFrame:CreateTexture(nil, "ARTWORK", nil, 1)
   120→        RPGBB.leftGraphicBg:SetAtlas("dragonriding_sgvigor_fillfull")
   121→        -- RPGBB.leftGraphicBg:SetVertexColor(0x46/255, 0x22/255, 0x6a/255, 1) -- #46226a
   122→        RPGBB.leftGraphicBg:SetDesaturated(true)
   123→
   124→        -- Left Graphic Foreground (the frame)
   125→        RPGBB.leftGraphicFg = RPGBB.leftGraphicFrame:CreateTexture(nil, "ARTWORK", nil, 2)
   126→        RPGBB.leftGraphicFg:SetAtlas("dragonriding_sgvigor_frame_dark")
   127→        RPGBB.leftGraphicFg:SetPoint("CENTER", RPGBB.frame, "LEFT", -2, 0)
   128→
   129→        -- Anchor background to foreground center
   130→        RPGBB.leftGraphicBg:SetPoint("CENTER", RPGBB.leftGraphicFg, "CENTER", 0, 0)
   131→
   132→        -- Left Graphic Accent (decorative element)
   133→        RPGBB.leftGraphicAccent = RPGBB.leftGraphicFrame:CreateTexture(nil, "ARTWORK", nil, 3)
   134→        RPGBB.leftGraphicAccent:SetAtlas("dragonriding_sgvigor_decor_dark")
   135→        RPGBB.leftGraphicAccent:SetTexCoord(1, 0, 0, 1) -- Mirror horizontally
   136→    end
   137→    RPGBB.leftGraphicAccent:SetPoint("BOTTOMRIGHT", RPGBB.leftGraphicFg, "BOTTOMLEFT", (RPGBB.fg_w / 2.25) , -(RPGBB.fg_h * 0.015))
   138→
   139→    RPGBB.leftGraphicBg:SetSize(RPGBB.bg_w, RPGBB.bg_h)
   140→
