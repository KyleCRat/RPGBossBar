   188→local function onEditModeEnter()
   189→	lib.isEditing = true
   190→
   191→	resetDialogs()
   192→	resetSelection()
   193→
   194→	for _, callback in next, lib.anonCallbacksEnter do
   195→		securecallfunction(callback)
   196→	end
   197→end
   198→
   199→local function onEditModeExit()
   200→	lib.isEditing = false
   201→
   202→	resetDialogs()
   203→	resetSelection()
   204→
   205→	for _, callback in next, lib.anonCallbacksExit do
   206→		securecallfunction(callback)
   207→	end
   208→end
   209→
   210→local function onEditModeChanged(_, layoutInfo)
   211→	local activeLayout = layoutInfo.activeLayout
   212→	if activeLayout ~= lib.activeLayout then
   213→		lib.activeLayout = activeLayout
   214→
   215→		-- update cache
   216→		lib.layoutCache = C_EditMode.GetLayouts().layouts
   217→
   218→		-- trigger callbacks
   219→		for _, callback in next, lib.anonCallbacksLayout do
   220→			securecallfunction(callback, layoutNames[activeLayout], activeLayout)
   221→		end
   222→
   223→		-- update dialog
   224→		if internal.dialog and internal.dialog.selection then
   225→			internal.dialog:Update(internal.dialog.selection)
   226→		end
   227→
   228→		-- TODO: we should update the position of the button here, let the user not deal with that
   229→	end
   230→end
   231→
   232→local function onSpecChanged(_, unit)
   233→	if unit ~= 'player' then
   234→		return
   235→	end
   236→
   237→	onEditModeChanged(nil, C_EditMode.GetLayouts())
   238→end
   239→
   240→local layoutCopySource
   241→local function onEditModeLayoutChanged()
   242→	local layoutInfo = C_EditMode.GetLayouts()
   243→	local layouts = layoutInfo.layouts
   244→
   245→	if #layouts > #lib.layoutCache then
   246→		-- a layout was created
   247→
   248→		for index, layout in next, layouts do
   249→			if not lib.layoutCache[index] then
   250→				for _, callback in next, lib.anonCallbacksCreate do
   251→					securecallfunction(callback, layout.layoutName, index, layoutCopySource and layoutCopySource.layoutName)
   252→				end
   253→			end
   254→		end
   255→
   256→		-- the game automatically switches to the newly created layout, which triggers
   257→		-- onEditModeChanged so we don't have to deal with that
   258→	elseif #layouts < #lib.layoutCache then
   259→		-- a layout was deleted
   260→
   261→		local newNames = {}
   262→		for _, layout in next, layouts do
   263→			newNames[layout.layoutName] = true
   264→		end
   265→
   266→		for _, layout in next, lib.layoutCache do
   267→			if not newNames[layout.layoutName] then
   268→				for _, callback in next, lib.anonCallbacksDelete do
   269→					securecallfunction(callback, layout.layoutName)
   270→				end
   271→
   272→				break
   273→			end
   274→		end
   275→
   276→		-- if the deleted layout was the current one the game automatically switches to Modern,
   277→		-- which triggers onEditModeChanged so we don't have to deal with that
   278→	else
   279→		-- a layout was renamed
   280→
   281→		for index, layout in next, layouts do
   282→			if layout.layoutName ~= lib.layoutCache[index].layoutName then
   283→				for _, callback in next, lib.anonCallbacksRename do
   284→					securecallfunction(callback, lib.layoutCache[index].layoutName, layout.layoutName, index)
   285→				end
   286→
   287→				if index == (lib.activeLayout - 2) then
   288→					-- the currently active layout was renamed, we trigger a layout update
   289→					lib.activeLayout = nil
   290→					onEditModeChanged(nil, layoutInfo)
   291→					return -- no need to proceed, the remaining tasks are already handled
   292→				end
   293→
   294→				break
   295→			end
   296→		end
   297→	end
   298→
   299→	layoutCopySource = nil
   300→	lib.layoutCache = layouts
   301→end
   302→
   303→local isManagerHooked = false
   304→
   305→local function hookManager()
   306→	-- listen for layout changes
   307→	EventRegistry:RegisterFrameEventAndCallback('EDIT_MODE_LAYOUTS_UPDATED', onEditModeChanged)
   308→	EventRegistry:RegisterFrameEventAndCallback('PLAYER_SPECIALIZATION_CHANGED', onSpecChanged)
   309→	EventRegistry:RegisterCallback('EditMode.SavedLayouts', onEditModeLayoutChanged)
   310→
   311→	-- hook EditMode shown state, since QuickKeybindMode will hide/show EditMode
   312→	EditModeManagerFrame:HookScript('OnShow', onEditModeEnter)
   313→	EditModeManagerFrame:HookScript('OnHide', onEditModeExit)
   314→
   315→	-- we don't want any custom frames dangling around
   316→	EditModeSystemSettingsDialog:HookScript('OnHide', resetDialogs)
   317→
   318→	-- unselect our selections whenever a system is selected and try to add an extension
   319→	hooksecurefunc(EditModeManagerFrame, 'SelectSystem', function(_, systemFrame)
   320→		resetDialogs()
   321→		resetSelection()
   322→
   323→		if internal.dialog then
   324→			internal.dialog:Reset()
   325→		end
   326→
   327→		local systemID = systemFrame.system
   328→		local subSystemID = systemFrame.systemIndex
   329→		local isKnownSystem = lib.systemSettings[systemID] or lib.systemButtons[systemID]
   330→		local isKnownSubSystem = subSystemID and ((lib.subSystemSettings[systemID] and lib.subSystemSettings[systemID][subSystemID]) or (lib.subSystemButtons[systemID] and lib.subSystemButtons[systemID][subSystemID]))
   331→		if isKnownSystem or isKnownSubSystem then
   332→			internal.extension:Update(systemID, isKnownSubSystem and subSystemID or nil)
   333→		end
   334→	end)
   335→
   336→	hooksecurefunc(EditModeManagerFrame, 'ShowNewLayoutDialog', function(_, sourceLayout)
   337→		layoutCopySource = sourceLayout
   338→	end)
   339→
   340→	-- fetch layout info in case EDIT_MODE_LAYOUTS_UPDATED already fired
   341→	if lib.layoutCache then
   342→		onEditModeChanged(nil, C_EditMode.GetLayouts()) -- introduces a little latency
   343→	end
   344→
   345→	isManagerHooked = true
   346→end
