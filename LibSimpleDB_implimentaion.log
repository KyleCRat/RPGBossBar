   157→        RPGBB.rightGraphicBg:SetAtlas("dragonriding_sgvigor_fillfull")
   158→        -- RPGBB.rightGraphicBg:SetVertexColor(0x46/255, 0x22/255, 0x6a/255, 1) -- #46226a
