   408→--[[ LibEditMode:EnableFrameSetting(_frame, settingName_) ![](https://img.shields.io/badge/function-blue)
   409→Enables a setting on a frame.
   410→
   411→* `frame`: frame widget already registered with [AddFrame](#libeditmodeaddframeframe-callback-default-)
   412→* `settingName`: a setting already registered with [AddFrameSettings](#libeditmodeaddframesettingsframe-settings-)
   413→--]]
   414→function lib:EnableFrameSetting(frame, settingName)
   415→	local settings = internal:GetFrameSettings(frame)
   416→	if settings then
   417→		for _, setting in next, settings do
   418→			if setting.name == settingName then
   419→				setting.disabled = false
   420→				internal.dialog:Update(internal.dialog.selection)
   421→				break
   422→			end
   423→		end
   424→	end
   425→end
