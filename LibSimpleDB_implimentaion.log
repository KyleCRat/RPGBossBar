   171→        RPGBB.rightGraphicAccent:SetAtlas("dragonriding_sgvigor_decor_dark")
   172→    end
   173→    RPGBB.rightGraphicAccent:SetPoint("BOTTOMLEFT", RPGBB.rightGraphicFg, "BOTTOMRIGHT", -(RPGBB.fg_w / 2.25) , -(RPGBB.fg_h * 0.015))
   174→
   175→    RPGBB.rightGraphicBg:SetSize(RPGBB.bg_w, RPGBB.bg_h)
   176→
   177→    RPGBB.rightGraphicFg:SetSize(RPGBB.fg_w, RPGBB.fg_h)
