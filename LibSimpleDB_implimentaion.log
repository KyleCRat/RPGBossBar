   112→-- addon.db.SetColor("health", "texture", "color", { r = 1, g = 0, b = 0, a = 1 })
   113→function addon.db.SetColor(...)
   114→    local args = { ... }
   115→    local new_color = args[#args]  -- Last argument is the color table
   116→
   117→    -- Validate the new color
   118→    if type(new_color) ~= "table" or not (new_color.r and new_color.g and new_color.b and new_color.a) then
   119→        print("ERROR! addon: SetColor: invalid color object")
   120→        return
   121→    end
   122→
   123→    -- Get the keys (all args except the last one)
   124→    local keys = {}
   125→    for i = 1, #args - 1 do
   126→        keys[i] = args[i]
   127→    end
   128→
   129→    -- Get the existing color object
   130→    local color = addon.db.GetDB(unpack(keys))
   131→
   132→
   133→    -- If it exists, update its values
   134→    if type(color) == "table" then
   135→        color.r = new_color.r
   136→        color.g = new_color.g
   137→        color.b = new_color.b
   138→        color.a = new_color.a
   139→    else
   140→        -- Create the color object if it doesn't exist
   141→        addon.db.Set(unpack(args))
   142→    end
   143→end
   144→
   145→-- addon.db.SetDefault("health", "texture", "atlas") -> sets addon.db.health.texture.atlas to default value
   146→function addon.db.SetDefault(...)
   147→    local keys = { ... }
   148→
   149→    -- Get the default value
   150→    local default_value = addon.db.defaults
   151→    for _, key in ipairs(keys) do
   152→        if type(default_value) ~= "table" then
   153→            return nil
   154→        end
   155→        default_value = default_value[key]
   156→    end
   157→
   158→    -- Deep copy if it's a table (like color objects)
   159→    if type(default_value) == "table" then
   160→        default_value = CopyTable(default_value)
   161→    end
   162→
   163→    -- Use Set to apply the default value
   164→    keys[#keys + 1] = default_value
   165→    addon.db.Set(unpack(keys))
   166→
   167→    return default_value
   168→end
