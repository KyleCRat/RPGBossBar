    27→lib.subSystemButtons = lib.subSystemButtons or {}
    28→
    29→lib.layoutCache = lib.layoutCache or {}
    30→
    31→local layoutNames = setmetatable({'Modern', 'Classic'}, {
    32→	__index = function(t, key)
    33→		if key > 2 then
    34→			-- the first 2 indices are reserved for 'Modern' and 'Classic' layouts, and anything
    35→			-- else are custom ones, although GetLayouts() doesn't return data for the 'Modern'
    36→			-- and 'Classic' layouts, so we'll have to substract and check
    37→			local layouts = lib.layoutCache
    38→			if (key - 2) <= #layouts then
    39→				return layouts[key - 2].layoutName
    40→			end
    41→		else
    42→			-- also work for 'Modern' and 'Classic'
    43→			rawget(t, key)
    44→		end
    45→	end
    46→})
    47→
    48→local function resetDialogs()
    49→	if internal.dialog then
    50→		internal.dialog:Hide()
    51→	end
    52→
    53→	if internal.extension then
    54→		internal.extension:Hide()
    55→	end
    56→end
    57→
    58→local function resetSelection()
    59→	for frame, selection in next, lib.frameSelections do
    60→		if selection.isSelected then
    61→			frame:SetMovable(false)
    62→		end
    63→
    64→		if not lib.isEditing then
    65→			selection:Hide()
    66→			selection.isSelected = false
    67→		else
    68→			selection:ShowHighlighted()
    69→		end
    70→	end
    71→end
    72→
    73→local function onDragStart(self)
    74→	if InCombatLockdown() then
    75→		-- TODO: maybe add a warning?
    76→		return
    77→	end
    78→
    79→	self:RegisterEvent('PLAYER_REGEN_DISABLED')
    80→	self.parent:StartMoving()
    81→end
    82→
    83→local function normalizePosition(frame)
    84→	-- ripped out of LibWindow-1.1, which is Public Domain
    85→	local parent = frame:GetParent()
    86→	if not parent then
    87→		return
    88→	end
    89→
    90→	local scale = frame:GetScale()
    91→	if not scale then
    92→		return
    93→	end
    94→
    95→	local left = frame:GetLeft() * scale
    96→	local top = frame:GetTop() * scale
    97→	local right = frame:GetRight() * scale
    98→	local bottom = frame:GetBottom() * scale
    99→
   100→	local parentWidth, parentHeight = parent:GetSize()
   101→
   102→	local x, y, point
   103→	if left < (parentWidth - right) and left < math.abs((left + right) / 2 - parentWidth / 2) then
   104→		x = left
   105→		point = 'LEFT'
   106→	elseif (parentWidth - right) < math.abs((left + right) / 2 - parentWidth / 2) then
   107→		x = right - parentWidth
   108→		point = 'RIGHT'
   109→	else
   110→		x = (left + right) / 2 - parentWidth / 2
   111→		point = ''
   112→	end
   113→
   114→	if bottom < (parentHeight - top) and bottom < math.abs((bottom + top) / 2 - parentHeight / 2) then
   115→		y = bottom
   116→		point = 'BOTTOM' .. point
   117→	elseif (parentHeight - top) < math.abs((bottom + top) / 2 - parentHeight / 2) then
   118→		y = top - parentHeight
   119→		point = 'TOP' .. point
   120→	else
   121→		y = (bottom + top) / 2 - parentHeight / 2
   122→		point = '' .. point
   123→	end
   124→
   125→	if point == '' then
   126→		point = 'CENTER'
   127→	end
   128→
   129→	return point, x / scale, y / scale
   130→end
   131→
   132→local function updatePosition(selection, xDelta, yDelta)
   133→	if InCombatLockdown() then
   134→		-- TODO: maybe add a warning?
   135→		return
   136→	end
   137→
   138→	local parent = selection.parent
   139→	local point, x, y = normalizePosition(parent)
   140→	x, y = x + (xDelta or 0), y + (yDelta or 0)
   141→	parent:ClearAllPoints()
   142→	parent:SetPoint(point, x, y)
   143→
   144→	internal:TriggerCallback(parent, point, x, y)
   145→
   146→	if selection.isSelected then
   147→		internal.dialog:Update(selection)
   148→	end
   149→end
   150→
   151→local function onDragStop(self)
   152→	if InCombatLockdown() then
   153→		return
   154→	end
   155→
   156→	local parent = self.parent
   157→	parent:StopMovingOrSizing()
   158→	self:UnregisterEvent('PLAYER_REGEN_DISABLED')
   159→
   160→	-- TODO: snap position to grid
   161→	-- FrameXML/EditModeUtil.lua
   162→
   163→	updatePosition(self)
   164→end
   165→
   166→local function onMouseDown(self) -- replacement for EditModeSystemMixin:SelectSystem()
   167→	if InCombatLockdown() then
   168→		-- TODO: maybe add a warning?
   169→		return
   170→	end
   171→
   172→	resetDialogs()
   173→	resetSelection()
   174→	EditModeManagerFrame:ClearSelectedSystem() -- possible taint
   175→
   176→	if not self.isSelected then
   177→		self.parent:SetMovable(true)
   178→		self:ShowSelected(true)
   179→
   180→		if internal.dialog.selection ~= self then
   181→			internal.dialog:Reset()
   182→		end
   183→
   184→		internal.dialog:Update(self)
   185→	end
   186→end
