    50→local function OnPositionChanged(frame, layoutName, point, x, y)
    51→    local point, _, relative_point, x, y = frame:GetPoint()
    52→    local uiScale = UIParent:GetScale()
    53→
    54→    x = PixelUtil.GetNearestPixelSize(x, uiScale)
    55→    y = PixelUtil.GetNearestPixelSize(y, uiScale)
    56→
    57→    RPGBB.db.Set("frame", "position", "point", point)
    58→    RPGBB.db.Set("frame", "position", "relative_point", relative_point)
    59→    RPGBB.db.Set("frame", "position", "x", x)
    60→    RPGBB.db.Set("frame", "position", "y", y)
    61→end
