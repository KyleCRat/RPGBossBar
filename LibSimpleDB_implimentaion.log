   489→--[[ LibEditMode:AddSystemSettings(_systemID, settings[, subSystemID]_) ![](https://img.shields.io/badge/function-blue)
   490→Register extra settings for a Blizzard system, it will be displayed in an dialog attached to the system's dialog in the Edit Mode.
   491→
   492→* `systemID`: the ID of a system registered with the Edit Mode. See [`Enum.EditModeSystem`](https://warcraft.wiki.gg/wiki/EDIT_MODE_LAYOUTS_UPDATED).
   493→* `settings`: table containing [SettingObject](Types#settingobject) entries _(table, number indexed)_
   494→* `subSystemID`: optional ID of a subsystem of a system registered with the Edit Mode. See [`Enum.EditMode...SystemIndices`](https://github.com/Gethe/wow-ui-source/blob/live/Interface/AddOns/Blizzard_APIDocumentationGenerated/EditModeManagerConstantsDocumentation.lua).
   495→--]]
   496→function lib:AddSystemSettings(systemID, settings, subSystemID)
   497→	if subSystemID then
   498→		if not lib.subSystemSettings[systemID] then
   499→			lib.subSystemSettings[systemID] = {}
   500→		end
   501→
   502→		if not lib.subSystemSettings[systemID][subSystemID] then
   503→			lib.subSystemSettings[systemID][subSystemID] = {}
   504→		end
   505→
   506→		for _, setting in next, settings do
   507→			table.insert(lib.subSystemSettings[systemID][subSystemID], setting)
   508→		end
   509→	else
   510→		if not lib.systemSettings[systemID] then
   511→			lib.systemSettings[systemID] = {}
   512→		end
   513→
   514→		for _, setting in next, settings do
   515→			table.insert(lib.systemSettings[systemID], setting)
   516→		end
   517→	end
   518→
   519→	if not internal.extension then
   520→		internal.extension = internal:CreateExtension()
   521→	end
   522→
   523→	if not isManagerHooked then
   524→		hookManager()
   525→	end
   526→end
