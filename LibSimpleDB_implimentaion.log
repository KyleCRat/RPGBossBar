   348→--[[ LibEditMode:AddFrame(_frame, callback, default_) ![](https://img.shields.io/badge/function-blue)
   349→Register a frame to be controlled by the Edit Mode.
   350→
   351→* `frame`: frame widget to be controlled
   352→* `callback`: callback that triggers whenever the frame has been repositioned
   353→* `default`: table containing the default position of the frame
   354→* `name`: name of the system, if nil, the frame's name will be used
   355→
   356→The `default` table must contain the following entries:
   357→
   358→* `point`: relative anchor point, e.g. `"CENTER"` _(string)_
   359→* `x`: horizontal offset from the anchor point _(number)_
   360→* `y`: vertical offset from the anchor point _(number)_
   361→--]]
   362→function lib:AddFrame(frame, callback, default, name)
   363→	local selection = CreateFrame('Frame', nil, frame, 'EditModeSystemSelectionTemplate')
   364→	selection:SetAllPoints()
   365→	selection:SetScript('OnMouseDown', onMouseDown)
   366→	selection:SetScript('OnDragStart', onDragStart)
   367→	selection:SetScript('OnDragStop', onDragStop)
   368→	selection:SetScript('OnEvent', onDragStop)
   369→	selection:Hide()
   370→
   371→	-- as of 11.2 the template requires a system name to work correctly
   372→	selection.system = {
   373→		GetSystemName = function()
   374→			return name or frame.editModeName or frame:GetName()
   375→		end
   376→	}
   377→
   378→	lib.frameSelections[frame] = selection
   379→	lib.frameCallbacks[frame] = callback
   380→	lib.frameDefaults[frame] = default
   381→
   382→	if not internal.dialog then
   383→		internal.dialog = internal:CreateDialog()
   384→		internal.dialog:HookScript('OnHide', function()
   385→			resetSelection()
   386→		end)
   387→
   388→		if not isManagerHooked then
   389→			hookManager()
   390→		end
   391→	end
   392→end
