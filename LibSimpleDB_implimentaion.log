   215→function RPGBB:Print(msg)
   216→    print("|c" .. addon_color .. ADDON_NAME .. ":|r " .. msg)
   217→end
   218→
   219→function RPGBB:VPrint(msg)
   220→    if not verbose then return end
   221→
   222→    print("|c" .. addon_color .. "RPGBB" .. ":|r " .. msg)
   223→end
   224→
   225→function RPGBB:Lock(locked)
   226→    RPGBB:VPrint("Lock: " .. (locked and "true" or "false"))
   227→    if locked then
   228→        RPGBB.frame:Hide()
   229→
   230→        if testing then
   231→            RPGBB:ToggleTest()
   232→        end
   233→    else -- unlocked
   234→        RPGBB.frame:Show()
   235→
   236→        if not testing then
   237→            RPGBB:ToggleTest(2)
   238→        end
   239→    end
   240→end
   241→
   242→function RPGBB:ToggleDebug()
   243→    verbose = not verbose
   244→    RPGBB:Print("debug turned " .. (verbose and "on" or "off"))
   245→end
   246→
   247→function RPGBB:ToggleTest(frame_count)
   248→    local received_frame_count_arg = ((frame_count and true) or false)
   249→    frame_count = tonumber(frame_count) or 2
   250→    frame_count = math.max(1, math.min(5, frame_count)) -- Clamp between 1 and 5
   251→
   252→    RPGBB:VPrint("ToggleTest: received_frame_count_arg " .. ((frame_count and "true") or "false"))
   253→    RPGBB:VPrint("ToggleTest: frame_count: " .. frame_count .. " current_boss_frames_count " .. #RPGBB.current_boss_frames)
   254→
   255→    -- Toggle test if:
   256→    --   We are not testing: Show
   257→    --   We are testing: if no frame_count passed
   258→    --                   or frame_count is the same as current test: Hide
   259→    if not testing or (not received_frame_count_arg
   260→                        or #RPGBB.current_boss_frames == frame_count) then
   261→        testing = not testing
   262→
   263→        RPGBB:Print("testing turned " .. (testing and "on" or "off"))
   264→    end
   265→
   266→    if testing then
   267→        local test_boss_frames = {}
   268→        for i = 1, frame_count do
   269→            table.insert(test_boss_frames, "boss" .. i)
   270→        end
   271→
   272→        RPGBB.current_boss_frames = test_boss_frames
   273→        RPGBB:UpdateFrames()
   274→
   275→        for _, boss_frame in ipairs(test_boss_frames) do
   276→            local test_max_health = 214748364
   277→            local test_health = math.random(1, test_max_health)
   278→            local test_percent = (test_health / test_max_health) * 100
   279→
   280→            RPGBB:RenderHealthChanges(boss_frame, test_health, test_max_health, test_percent)
   281→        end
   282→
   283→        RPGBB.current_boss_frames = test_boss_frames
   284→        RPGBB.frame:Show()
   285→    else
   286→        RPGBB.current_boss_frames = {}
   287→        RPGBB:UpdateFrames()
   288→        RPGBB.frame:Hide()
   289→    end
   290→end
   291→
   292→function RPGBB:UpdateHealth()
   293→    for _, boss_frame in ipairs(RPGBB.current_boss_frames) do
   294→        RPGBB:RenderHealthChanges(boss_frame)
   295→    end
   296→end
   297→
   298→function RPGBB:RenderHealthChanges(boss_frame, abs_health, max_health, per_health)
   299→    local health_bar = RPGBB.health_bars[boss_frame]
   300→
   301→    local abs_health = abs_health or UnitHealth(boss_frame)
   302→    local max_health = max_health or UnitHealthMax(boss_frame)
   303→    local per_health = per_health or UnitHealthPercent(boss_frame, true, CurveConstants.ScaleTo100) or 0
   304→
   305→    if health_bar and health_bar.frame then
   306→        -- Render frame values
   307→        health_bar.frame:SetMinMaxValues(0, max_health)
   308→        health_bar.frame:SetValue(abs_health)
   309→
   310→        -- Render absolute health
   311→        health_bar.health_text:SetText(BreakUpLargeNumbers(abs_health))
   312→
   313→        -- Render percent health
   314→        health_bar.percent_text:SetText(string.format("%.1f%%", per_health))
   315→
   316→        -- make sure health frame is showing? shouldn't need.
   317→        -- health_bar.frame:Show()
   318→    end
   319→end
   320→
   321→function RPGBB:HaveBossFramesChanged(new_frames)
   322→    local current = RPGBB.current_boss_frames
   323→
   324→    if #current ~= #new_frames then
   325→        return true
   326→    end
   327→
   328→    for i, frame in ipairs(new_frames) do
   329→        if current[i] ~= frame then
   330→            return true
   331→        end
   332→    end
   333→
   334→    return false
   335→end
   336→
   337→-- Returns:
   338→--   true if we have any boss frames we should be tracking and BossBar should be visible
   339→--  false if we are not tracking boss frames and BossBar should be hidden
   340→function RPGBB:IsBossFramesToUpdate()
   341→    local boss_frames = {}
   342→
   343→    -- 5 boss frames maximum
   344→    for i = 1, 5 do
   345→        local unit = "boss" .. i
   346→        if UnitExists(unit) and (UnitClassification(unit) == "elite"
   347→                                 or UnitClassification(unit) == "worldboss") then
   348→            table.insert(boss_frames, unit)
   349→        end
   350→    end
   351→
   352→    -- If there are no boss frames we don't have anything to render or update, hide
   353→    if #boss_frames == 0 then
   354→        RPGBB.frame:Hide()
   355→        RPGBB.current_boss_frames = boss_frames
   356→        return false
   357→    end
   358→
   359→    -- Otherwise we have at least one boss frame to update, show
   360→    RPGBB.frame:Show()
   361→
   362→    -- Only rebuild frames if boss frames have changed
   363→    if not RPGBB:HaveBossFramesChanged(boss_frames) then
   364→        return true
   365→    end
   366→
   367→    RPGBB.current_boss_frames = boss_frames
   368→    RPGBB:UpdateFrames()
   369→
   370→    return true
   371→end
   372→
   373→function RPGBB:UpdateFrames()
   374→    local frame_height = RPGBB.db.Get("frame", "height")
   375→    local frame_width  = RPGBB.db.Get("frame", "width")
   376→
   377→    local boss_frame_count = #RPGBB.current_boss_frames
   378→    local health_bar_width = frame_width / boss_frame_count
   379→
   380→    -- Hide all visible elements for updating
   381→    for _, bf in pairs(RPGBB.health_bars) do
   382→        bf.frame:Hide()
   383→        if bf.mid_graphic_frame then bf.mid_graphic_frame:Hide() end
   384→    end
   385→
   386→    -- Get all db values before looping so we only get them once
   387→    -- If we are using an atlas texture
   388→    -- if RPGBB.db.get("health", "texture", "atlas") then
   389→    local health_bar_texture_is_atlas = RPGBB.db.Get("health", "texture", "atlas")
   390→    local health_bar_texture          = RPGBB.db.Get("health", "texture", "texture")
   391→    local health_bar_atlas_texture    = RPGBB.db.Get("health", "texture", "atlas_texture")
   392→    local health_bar_desaturated      = RPGBB.db.Get("health", "texture", "desaturated")
   393→    local hb_r, hb_b, hb_g, hb_a      = RPGBB.db.GetColor("health", "texture", "color")
   394→
   395→    local health_font_offset_y = RPGBB.db.Get("health", "font", "offset", "y")
   396→
   397→    local spark_atlas            = RPGBB.db.Get("health", "spark", "atlas")
   398→    local sp_r, sp_b, sp_g, sp_a = RPGBB.db.GetColor("health", "spark", "color")
   399→    local spark_blend_mode       = RPGBB.db.Get("health", "spark", "blend_mode")
   400→    local spark_width            = RPGBB.db.Get("health", "spark", "width")
   401→    local spark_height_multi     = RPGBB.db.Get("health", "spark", "height_multi")
   402→
   403→    local name_y_offset = RPGBB.db.Get("name", "offset", "y")
   404→
   405→    local health_percent_offset_x = RPGBB.db.Get("health", "percent_font", "offset", "x")
   406→    local disable_per_above       = RPGBB.db.Get("health", "percent_font", "disable_above")
   407→
   408→    local ac_r, ac_b, ac_g, ac_a = RPGBB.db.GetColor("accents", "color")
   409→
   410→    for i, boss_frame in ipairs(RPGBB.current_boss_frames) do
   411→        RPGBB:VPrint("RPGBB: " .. boss_frame .. " i: " .. i)
   412→
   413→        RPGBB.health_bars[boss_frame] = RPGBB.health_bars[boss_frame] or {}
   414→
   415→        local y_left_offset = health_bar_width * (i - 1)
   416→
   417→        -- Healthbar Frame
   418→        if not RPGBB.health_bars[boss_frame].frame then
   419→            RPGBB:VPrint(boss_frame .. " did not exist, creating.")
   420→            RPGBB.health_bars[boss_frame].frame = CreateFrame("StatusBar", "RPG".. boss_frame .."BarHealthBar", RPGBB.frame)
   421→            RPGBB.health_bars[boss_frame].frame:SetFrameLevel(RPGBB.frame:GetFrameLevel() + HEALTH_BAR_LEVEL)
   422→        else
   423→            RPGBB:VPrint(boss_frame .. " Already Existed.")
   424→        end
   425→        -- Update each time for setting changes
   426→        if health_bar_texture_is_atlas then
   427→            RPGBB.health_bars[boss_frame].frame:SetStatusBarTexture("Interface\\TargetingFrame\\UI-StatusBar")
   428→            RPGBB.health_bars[boss_frame].frame:GetStatusBarTexture():SetAtlas(health_bar_atlas_texture)
   429→        else
   430→            RPGBB.health_bars[boss_frame].frame:SetStatusBarTexture(health_bar_texture)
   431→        end
   432→        RPGBB.health_bars[boss_frame].frame:GetStatusBarTexture():SetDesaturated(health_bar_desaturated)
   433→        RPGBB.health_bars[boss_frame].frame:SetStatusBarColor(hb_r, hb_b, hb_g, hb_a)
   434→        -- Update each time for frame count changes
   435→        RPGBB.health_bars[boss_frame].frame:ClearAllPoints()
   436→        RPGBB.health_bars[boss_frame].frame:SetPoint("LEFT", RPGBB.frame, "LEFT", y_left_offset, 0)
   437→        RPGBB.health_bars[boss_frame].frame:SetSize(health_bar_width, frame_height)
   438→        RPGBB.health_bars[boss_frame].frame:Show()
   439→
   440→        -- Healthbar Spark
   441→        if not RPGBB.health_bars[boss_frame].spark then
   442→            RPGBB.health_bars[boss_frame].spark = RPGBB.health_bars[boss_frame].frame:CreateTexture(nil, "OVERLAY")
   443→            RPGBB.health_bars[boss_frame].spark:SetPoint("CENTER", RPGBB.health_bars[boss_frame].frame:GetStatusBarTexture(), "RIGHT", 0, 0)
   444→        end
   445→        -- Update each time for setting changes
   446→        RPGBB.health_bars[boss_frame].spark:SetAtlas(spark_atlas)
   447→        RPGBB.health_bars[boss_frame].spark:SetVertexColor(sp_r, sp_b, sp_g, sp_a)
   448→        RPGBB.health_bars[boss_frame].spark:SetBlendMode(spark_blend_mode)
   449→        RPGBB.health_bars[boss_frame].spark:SetSize(spark_width, frame_height * spark_height_multi)
   450→
   451→        -- Healthbar absolute value health text
   452→        if not RPGBB.health_bars[boss_frame].health_text then
   453→            RPGBB.health_bars[boss_frame].health_text = RPGBB.health_bars[boss_frame].frame:CreateFontString(nil, "OVERLAY")
   454→        end
   455→        -- Update each time for setting changes
   456→        RPGBB.health_bars[boss_frame].health_text:SetPoint("CENTER", RPGBB.health_bars[boss_frame].frame, "CENTER", 0, health_font_offset_y)
   457→        RPGBB.health_bars[boss_frame].health_text:SetFontObject(RPGBB.health_font)
   458→
   459→        -- Healthbar percentage text (right side of bar)
   460→        if not RPGBB.health_bars[boss_frame].percent_text then
   461→            RPGBB.health_bars[boss_frame].percent_text = RPGBB.health_bars[boss_frame].frame:CreateFontString(nil, "OVERLAY")
   462→        end
   463→        RPGBB.health_bars[boss_frame].percent_text:SetPoint("RIGHT", RPGBB.health_bars[boss_frame].frame, "RIGHT", health_percent_offset_x, health_font_offset_y)
   464→        RPGBB.health_bars[boss_frame].percent_text:SetFontObject(RPGBB.health_font)
   465→
   466→        -- Healthbar name text (above frame)
   467→        if not RPGBB.health_bars[boss_frame].name_text then
   468→            RPGBB.health_bars[boss_frame].name_text = RPGBB.health_bars[boss_frame].frame:CreateFontString(nil, "OVERLAY")
   469→            RPGBB.health_bars[boss_frame].name_text:SetWordWrap(false)
   470→        end
   471→        RPGBB.health_bars[boss_frame].name_text:SetPoint("BOTTOM", RPGBB.health_bars[boss_frame].frame, "TOP", 0, name_y_offset)
   472→        RPGBB.health_bars[boss_frame].name_text:SetFontObject(RPGBB.name_font)
   473→        RPGBB.health_bars[boss_frame].name_text:SetWidth(health_bar_width)
   474→        RPGBB.health_bars[boss_frame].name_text:SetText(UnitName(boss_frame) or "Test Boss " .. boss_frame:match("%d+"))
   475→
   476→        -- Hide percentage if more than 2 bosses exist
   477→        if boss_frame_count > disable_per_above then
   478→            RPGBB.health_bars[boss_frame].percent_text:Hide()
   479→        else
   480→            RPGBB.health_bars[boss_frame].percent_text:Show()
   481→        end
   482→
   483→        -- Don't create extra divider graphic elements
   484→        if i == boss_frame_count then break end
   485→
   486→        -------------------------------------------------------------------------------
   487→        --- Middle Graphic Elements, create and attach on the right of all but n-1 bar
   488→        -------------------------------------------------------------------------------
   489→
   490→        local middle_graphic_width_mult = 0.7
   491→        -- Create overlay frame for left graphics (sits on top of health bar)
   492→        if not RPGBB.health_bars[boss_frame].mid_graphic_frame then
   493→            RPGBB.health_bars[boss_frame].mid_graphic_frame = CreateFrame("Frame", "RPGBossBarLeftGraphic", RPGBB.health_bars[boss_frame].frame)
   494→            RPGBB.health_bars[boss_frame].mid_graphic_frame:SetAllPoints(RPGBB.health_bars[boss_frame].frame)
   495→            RPGBB.health_bars[boss_frame].mid_graphic_frame:SetFrameLevel(RPGBB.health_bars[boss_frame].frame:GetFrameLevel() + GRAPHICS_LEVEL)
   496→        end
   497→        RPGBB.health_bars[boss_frame].mid_graphic_frame:Show()
   498→
   499→        -- Left Graphic Background (behind foreground)
   500→        if not RPGBB.health_bars[boss_frame].mid_graphic_bg then
   501→            RPGBB.health_bars[boss_frame].mid_graphic_bg = RPGBB.health_bars[boss_frame].mid_graphic_frame:CreateTexture(nil, "ARTWORK", nil, 1)
   502→            RPGBB.health_bars[boss_frame].mid_graphic_bg:SetAtlas("dragonriding_sgvigor_fillfull")
   503→            RPGBB.health_bars[boss_frame].mid_graphic_bg:SetDesaturated(true)
   504→        end
   505→        RPGBB.health_bars[boss_frame].mid_graphic_bg:SetSize(RPGBB.bg_w * middle_graphic_width_mult, RPGBB.bg_h)
   506→
   507→        RPGBB.health_bars[boss_frame].mid_graphic_bg:SetVertexColor(ac_r, ac_b, ac_g, ac_a)
   508→
   509→        -- Left Graphic Foreground (the frame)
   510→        if not RPGBB.health_bars[boss_frame].mid_graphic_fg then
   511→            RPGBB.health_bars[boss_frame].mid_graphic_fg = RPGBB.health_bars[boss_frame].mid_graphic_frame:CreateTexture(nil, "ARTWORK", nil, 2)
   512→            RPGBB.health_bars[boss_frame].mid_graphic_fg:SetAtlas("dragonriding_sgvigor_frame_dark")
   513→            RPGBB.health_bars[boss_frame].mid_graphic_fg:SetPoint("CENTER", RPGBB.health_bars[boss_frame].frame, "RIGHT", 0, 0)
   514→
   515→            -- Anchor background to foreground center
   516→            RPGBB.health_bars[boss_frame].mid_graphic_bg:SetPoint("CENTER", RPGBB.health_bars[boss_frame].mid_graphic_fg, "CENTER", 0, 0)
   517→        end
   518→        RPGBB.health_bars[boss_frame].mid_graphic_fg:SetSize(RPGBB.fg_w * middle_graphic_width_mult, RPGBB.fg_h)
   519→    end
   520→end
   521→
   522→-------------------------------------------------------------------------------
   523→--- Event Handling
   524→-------------------------------------------------------------------------------
   525→
   526→local function EventHandler(self, event, arg1)
   527→    if event == "ADDON_LOADED" then
   528→        if arg1 == ADDON_NAME then
   529→            RPGBB.db.Initialize()
   530→            RPGBB:InitOrUpdateFrame()
   531→
   532→            RPGBB.frame:UnregisterEvent("ADDON_LOADED")
   533→
   534→            -- Register boss health events for all 5 possible boss units
   535→            RPGBB.frame:RegisterUnitEvent("UNIT_HEALTH", "boss1", "boss2", "boss3", "boss4", "boss5")
   536→            RPGBB.frame:RegisterUnitEvent("UNIT_MAXHEALTH", "boss1", "boss2", "boss3", "boss4", "boss5")
   537→            RPGBB.frame:RegisterEvent("INSTANCE_ENCOUNTER_ENGAGE_UNIT")
   538→            RPGBB.frame:RegisterEvent("PLAYER_REGEN_ENABLED")
   539→
   540→            RPGBB:Print("Loaded. Use " .. SLASH_RPGBOSSBAR1 .. " for commands.")
   541→        end
   542→
   543→    elseif event == "UNIT_HEALTH" or event == "UNIT_MAXHEALTH" then
   544→        -- If we are currently tracking a boss frame
   545→        if RPGBB:IsBossFramesToUpdate() then
   546→            -- Update health if this boss is being tracked
   547→            if RPGBB.health_bars[arg1] then
   548→                RPGBB:UpdateHealth()
   549→            end
   550→        end
   551→    elseif event == "PLAYER_REGEN_ENABLED" then
   552→        -- Exited combat
   553→        RPGBB.frame:Hide()
   554→    elseif event == "INSTANCE_ENCOUNTER_ENGAGE_UNIT" then
   555→        if RPGBB:IsBossFramesToUpdate() then
   556→            RPGBB:UpdateHealth()
   557→        end
   558→    end
   559→end
   560→
   561→-- Register events
   562→RPGBB.frame:RegisterEvent("ADDON_LOADED")
   563→
   564→RPGBB.frame:SetScript("OnEvent", EventHandler)
   565→
